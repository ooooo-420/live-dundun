<view class="wrap enter">
  <view class="title">邀请另一个微信号</view>
  <view wx:if="{{code}}" class="code-box" bindtap="copyCode">
    <view class="code num-font">{{code}}</view>
    <view class="muted">{{expiresText}} 前有效　·　点一下复制</view>
  </view>
  <view class="btn {{code ? 'ghost' : ''}}" hover-class="press" hover-stay-time="80" bindtap="makeCode">{{code ? '重新生成' : '生成邀请码'}}</view>

  <view class="section-label">目前成员　{{list.length}}</view>
</view>
<view class="list">
  <view wx:for="{{list}}" wx:key="index" class="member">
    <text>成员 {{index + 1}}<text class="muted">　…{{item.tail}}</text><text wx:if="{{item.me}}" class="me">你</text></text>
    <view wx:if="{{!item.me}}" class="danger-link" hover-class="press-link" data-index="{{item.index}}" bindtap="remove">移除</view>
  </view>
</view>
