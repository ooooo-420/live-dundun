.intro { font-size: 26rpx; margin-bottom: 28rpx; }
.code-box { padding: 32rpx 0; text-align: center; margin-bottom: 24rpx; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); }
.code { font-size: 96rpx; font-weight: 700; letter-spacing: 0.18em; color: var(--ember); line-height: 1.1; }
.list { border-top: 1rpx solid var(--line); }
.member { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid var(--line); }
.me { margin-left: 16rpx; font-size: 22rpx; color: var(--ember); }
.danger-link { color: #ff8a73; font-size: 26rpx; padding: 8rpx 0 8rpx 32rpx; }
.note { margin-top: 24rpx; }
