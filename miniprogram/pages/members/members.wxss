.wrap.enter { padding-top: 24rpx; }
.title { font-size: 48rpx; font-weight: 900; margin: 8rpx 0 32rpx; }
.code-box { padding: 40rpx 0 30rpx; text-align: center; margin-bottom: 28rpx; background: var(--bam); color: #fff; border-radius: 48rpx; box-shadow: 0 30rpx 60rpx rgba(52, 121, 76, 0.28); }
.code-box .muted { color: rgba(255, 255, 255, 0.8); }
.code { font-size: 104rpx; font-weight: 800; letter-spacing: 0.16em; line-height: 1.1; }
.list { margin: 0 44rpx; background: var(--card); border-radius: 44rpx; box-shadow: var(--shadow); padding: 0 32rpx; }
.member { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 0; border-bottom: 2rpx solid var(--bg); }
.member:last-child { border-bottom: 0; }
.me { margin-left: 16rpx; font-size: 22rpx; color: #fff; background: var(--bam); padding: 4rpx 14rpx; border-radius: 20rpx; }
.danger-link { color: var(--danger); font-size: 26rpx; padding: 8rpx 0 8rpx 32rpx; }
.note { margin-top: 28rpx; }
