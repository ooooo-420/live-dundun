.grow { flex: 1; min-width: 0; }

.head { padding-top: 24rpx; padding-bottom: 12rpx; }
.verify-row { margin-bottom: 24rpx; padding: 22rpx 30rpx; background: var(--tom-tint); color: #b4471f; font-weight: 700; font-size: 26rpx; border-radius: 32rpx; }
.now { display: flex; align-items: flex-end; gap: 24rpx; }
.big-wrap { position: relative; display: inline-block; overflow: hidden; }
.big { display: block; font-size: 212rpx; line-height: 0.9; font-weight: 800; color: var(--bam); }
.flip-out { position: absolute; left: 0; top: 0; animation: flipOut 0.35s cubic-bezier(0.4, 0, 0.2, 1) both; }
.flip-in { animation: flipIn 0.5s cubic-bezier(0.3, 1.3, 0.5, 1) both; }
@keyframes flipOut { from { transform: none; opacity: 1; } 60% { opacity: 0; } to { transform: translateY(-110%); opacity: 0; } }
@keyframes flipIn { from { transform: translateY(110%); opacity: 0; } 30% { opacity: 0; } to { transform: none; opacity: 1; } }
.now-side { display: flex; flex-direction: column; min-width: 0; padding-bottom: 20rpx; font-size: 27rpx; color: var(--soft); line-height: 1.5; }
.now-title { color: var(--ink); font-weight: 700; font-size: 30rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.type { font-size: 24rpx; color: var(--mute); }
.state-big { font-size: 48rpx; font-weight: 900; padding: 20rpx 0; }

.quick { display: flex; gap: 20rpx; margin-top: 28rpx; }
.pick-btn { width: 168rpx; flex: none; }

.seg { display: flex; background: #e9e3d4; border-radius: 36rpx; padding: 8rpx; margin-top: 28rpx; }
.seg-i { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 28rpx; font-size: 25rpx; font-weight: 700; color: var(--soft); transition: background 0.2s, color 0.2s; }
.seg-i.on { background: #fff; color: var(--ink); box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08); }

.opt { display: flex; justify-content: space-between; align-items: center; gap: 24rpx; padding: 28rpx 8rpx; border-bottom: 2rpx solid var(--line); }

.list-head { display: flex; justify-content: space-between; align-items: center; }
.picked { color: var(--bam); display: flex; align-items: center; gap: 20rpx; }
.clear { color: var(--mute); font-weight: 400; font-size: 26rpx; }
/* “只看已选”：小胶囊，开着时实心 */
.only { font-size: 24rpx; font-weight: 700; padding: 8rpx 24rpx; border-radius: 30rpx; color: var(--bam); background: var(--bam-tint); transition: background 0.2s, color 0.2s, transform 0.14s; }
.only.on { background: var(--bam); color: #fff; }
.item.gone { display: none; }
.empty { padding: 40rpx; color: var(--soft); font-size: 26rpx; }

.list { display: flex; flex-direction: column; gap: 16rpx; }
.item { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 28rpx; background: var(--card); border-radius: 40rpx; transition: box-shadow 0.2s, transform 0.15s; }
.item.exp { box-shadow: inset 0 0 0 4rpx var(--bam); }
.idx { width: 80rpx; height: 80rpx; flex: none; border-radius: 26rpx; background: var(--bg); display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 800; color: var(--soft); transition: background 0.2s, color 0.2s; }
.item.on .idx { background: var(--bam); color: #fff; }
.t { font-size: 28rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.exp-tag { color: var(--bam); font-weight: 700; }
.check { width: 48rpx; height: 48rpx; flex: none; border-radius: 16rpx; box-shadow: inset 0 0 0 4rpx #d4cdbd; display: flex; align-items: center; justify-content: center; transition: background 0.2s, box-shadow 0.2s; }
.item.on .check { background: var(--bam); box-shadow: none; }
.tick { width: 10rpx; height: 20rpx; border: solid #fff; border-width: 0 5rpx 5rpx 0; transform: rotate(45deg) translate(-1rpx, -3rpx); opacity: 0; }
.item.on .tick { opacity: 1; }

.foot { padding-top: 48rpx; text-align: center; }
.danger-link { color: var(--danger); font-size: 26rpx; padding: 20rpx 32rpx; }

.spacer { height: 200rpx; }
.bottom { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 24rpx 44rpx calc(28rpx + env(safe-area-inset-bottom)); background: linear-gradient(rgba(243, 239, 227, 0), var(--bg) 40%); }
