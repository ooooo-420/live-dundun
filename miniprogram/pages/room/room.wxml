<wxs src="../../utils/text.wxs" module="tx" />
<view wx:if="{{room}}">
  <!-- 现况（淡入不要放最外层：会让底下固定的保存键跟着位移） -->
  <view class="wrap head enter">
    <view wx:if="{{room.status === 'captcha'}}" class="verify-row" hover-class="press" bindtap="goVerify">抖音要人机验证 · 点这里在手机上完成 ›</view>
    <view wx:if="{{room.status === 'live' && room.explaining && room.explaining.index}}" class="now">
      <view class="big-wrap">
        <text wx:if="{{bump && prevIndex}}" class="big num-font flip-out">{{prevIndex}}</text>
        <text class="big num-font {{bump ? 'flip-in' : ''}}">{{room.explaining.index}}</text>
      </view>
      <view class="now-side">
        <text>号 讲解中</text>
        <text class="now-title {{tx.hang(room.explaining.title) ? 'hang' : ''}}">{{room.explaining.title}}</text>
      </view>
    </view>
    <view wx:else class="state-big">{{statusText}}</view>
  </view>

  <!-- 选号 -->
  <view class="wrap">
    <view class="quick">
      <input class="input grow num-font {{quick ? 'focus' : ''}}" placeholder="输入号码：2-10 或 3 5 8" placeholder-class="ph" value="{{quick}}" bindinput="onQuick" confirm-type="done" bindconfirm="applyQuick" />
      <view class="btn pick-btn {{quick ? '' : 'ghost'}}" hover-class="press" hover-stay-time="80" bindtap="applyQuick">选取</view>
    </view>

    <view class="seg">
      <view wx:for="{{aheadOptions}}" wx:key="*this" class="seg-i {{aheadIdx === index ? 'on' : ''}}" hover-class="press-link" data-i="{{index}}" bindtap="onSeg">{{item}}</view>
    </view>
    <view class="opt">
      <view>
        <view>错过提醒</view>
        <view class="muted">照顺序讲，却跳过你要的号码时</view>
      </view>
      <view class="toggle sm {{missed ? 'on' : ''}}" hover-class="press" hover-stay-time="80" bindtap="onMissed"><view class="knob"></view></view>
    </view>
  </view>

  <!-- 购物车 -->
  <view class="wrap">
    <view class="section-label list-head">
      <text>购物车 {{cart.length}} 件</text>
      <view class="picked"><text>已选 {{pickedCount}}</text><text wx:if="{{pickedCount}}" class="clear" bindtap="clearAll">全部取消</text></view>
    </view>
    <view wx:if="{{cart.length === 0}}" class="card empty">还没有购物车清单。直播开始后，电脑会自动读取。</view>
    <view class="list" wx:if="{{cart.length}}">
      <view wx:for="{{cart}}" wx:key="id" class="item {{picked[item.id] ? 'on' : ''}} {{room.explaining && room.explaining.id === item.id ? 'exp' : ''}}" hover-class="press-row" hover-start-time="40" hover-stay-time="80" data-id="{{item.id}}" bindtap="toggle">
        <view class="idx num-font">{{item.index}}</view>
        <view class="grow">
          <view class="t {{tx.hang(item.title) ? 'hang' : ''}}">{{item.title}}</view>
          <view class="muted">¥{{item.price}}<text wx:if="{{room.explaining && room.explaining.id === item.id}}" class="exp-tag"> · 讲解中</text></view>
        </view>
        <view class="check"><view class="tick"></view></view>
      </view>
    </view>
  </view>

  <view class="foot">
    <text class="danger-link" bindtap="remove">删除这个直播间</text>
  </view>
  <view class="spacer"></view>

  <view class="bottom">
    <view wx:if="{{dirty}}" class="btn" hover-class="press" hover-stay-time="80" bindtap="save">保存目标 · {{pickedCount}} 件</view>
    <view wx:else class="btn ghost">{{pickedCount ? '已保存 · ' + pickedCount + ' 件' : '点商品或输入号码来选'}}</view>
  </view>
</view>
