<view wx:if="{{room}}">
  <!-- 現況（不要把淡入放在最外層：會讓底下固定的儲存鍵跟著位移） -->
  <view class="wrap head enter">
    <view class="head-row">
      <text class="state {{room.status === 'live' ? 'live' : ''}}">{{statusText}}</text>
      <text class="muted" wx:if="{{room.type}}">{{room.type === 'A' ? '講解中會被置頂成 1 號' : '號碼不會變'}}</text>
    </view>
    <view wx:if="{{room.status === 'live' && room.explaining && room.explaining.index}}" class="now">
      <view class="big-wrap">
        <text wx:if="{{bump && prevIndex}}" class="big display-font flip-out">{{prevIndex}}</text>
        <text class="big display-font {{bump ? 'flip-in' : ''}}">{{room.explaining.index}}</text>
      </view>
      <view class="now-side">
        <text class="soft">號 講解中</text>
        <text class="now-title">{{room.explaining.title}}</text>
      </view>
    </view>
  </view>

  <!-- 設定 -->
  <view class="wrap">
    <view class="section-label">選號</view>
    <view class="quick">
      <input class="input grow num-font" placeholder="2-10 或 3 5 8" placeholder-class="ph" value="{{quick}}" bindinput="onQuick" confirm-type="done" bindconfirm="applyQuick" />
      <view class="btn pick-btn {{quick ? '' : 'ghost'}}" hover-class="press" hover-stay-time="80" bindtap="applyQuick">選取</view>
    </view>

    <view class="opt">
      <text>提前通知</text>
      <picker range="{{aheadOptions}}" value="{{aheadIdx}}" bindchange="onAhead">
        <view class="picker">{{aheadOptions[aheadIdx]}}<text class="chev">›</text></view>
      </picker>
    </view>
    <view class="opt">
      <view>
        <view>錯過提醒</view>
        <view class="muted">照順序講，卻跳過你要的號碼時</view>
      </view>
      <view class="toggle {{missed ? 'on' : ''}}" hover-class="press" hover-stay-time="80" bindtap="onMissed"><view class="knob"></view></view>
    </view>
    <view class="muted note">講到你選的號碼時，一定會通知。</view>
  </view>

  <!-- 購物車 -->
  <view class="wrap">
    <view class="section-label list-head">
      <text>購物車 {{cart.length}} 件　·　已選 {{pickedCount}}</text>
      <view wx:if="{{pickedCount}}" class="clear" hover-class="press-link" bindtap="clearAll">全部取消</view>
    </view>
  </view>

  <view wx:if="{{cart.length === 0}}" class="wrap muted empty">還沒有購物車清單。直播開始後，電腦會自動讀取。</view>

  <view class="list" wx:if="{{cart.length}}">
    <view wx:for="{{cart}}" wx:key="id" class="item {{picked[item.id] ? 'on' : ''}} {{room.explaining && room.explaining.id === item.id ? 'exp' : ''}}" hover-class="press-row" hover-start-time="40" hover-stay-time="80" data-id="{{item.id}}" bindtap="toggle">
      <view class="check"><view class="tick"></view></view>
      <text class="idx num-font">{{item.index}}</text>
      <view class="grow">
        <view class="t">{{item.title}}</view>
        <view class="muted">¥{{item.price}}<text wx:if="{{room.explaining && room.explaining.id === item.id}}" class="exp-tag">講解中</text></view>
      </view>
    </view>
  </view>

  <view class="wrap foot">
    <view class="danger-link link-btn" hover-class="press-link" bindtap="remove">刪除這個直播間</view>
  </view>
  <view class="spacer"></view>

  <view class="bottom">
    <view wx:if="{{dirty}}" class="btn" hover-class="press" hover-stay-time="80" bindtap="save">儲存目標　{{pickedCount}} 件</view>
    <view wx:else class="btn ghost saved">{{pickedCount ? '已儲存　' + pickedCount + ' 件' : '點商品或輸入號碼來選'}}</view>
  </view>
</view>
