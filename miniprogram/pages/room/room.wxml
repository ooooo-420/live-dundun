<view wx:if="{{room}}">
  <!-- 現況（淡入不要放最外層：會讓底下固定的儲存鍵跟著位移） -->
  <view class="wrap head enter">
    <view wx:if="{{room.status === 'captcha'}}" class="verify-row" hover-class="press" bindtap="goVerify">抖音要人機驗證 · 點這裡在手機上完成 ›</view>
    <view wx:if="{{room.status === 'live' && room.explaining && room.explaining.index}}" class="now">
      <view class="big-wrap">
        <text wx:if="{{bump && prevIndex}}" class="big num-font flip-out">{{prevIndex}}</text>
        <text class="big num-font {{bump ? 'flip-in' : ''}}">{{room.explaining.index}}</text>
      </view>
      <view class="now-side">
        <text>號 講解中</text>
        <text class="now-title">{{room.explaining.title}}</text>
        <text class="type" wx:if="{{room.type}}">{{room.type === 'A' ? '講解中會被置頂成 1 號' : '號碼不會變的直播間'}}</text>
      </view>
    </view>
    <view wx:else class="state-big">{{statusText}}</view>
  </view>

  <!-- 選號 -->
  <view class="wrap">
    <view class="quick">
      <input class="input grow num-font {{quick ? 'focus' : ''}}" placeholder="輸入號碼：2-10 或 3 5 8" placeholder-class="ph" value="{{quick}}" bindinput="onQuick" confirm-type="done" bindconfirm="applyQuick" />
      <view class="btn pick-btn {{quick ? '' : 'ghost'}}" hover-class="press" hover-stay-time="80" bindtap="applyQuick">選取</view>
    </view>

    <view class="seg">
      <view wx:for="{{aheadOptions}}" wx:key="*this" class="seg-i {{aheadIdx === index ? 'on' : ''}}" hover-class="press-link" data-i="{{index}}" bindtap="onSeg">{{item}}</view>
    </view>
    <view class="opt">
      <view>
        <view>錯過提醒</view>
        <view class="muted">照順序講，卻跳過你要的號碼時</view>
      </view>
      <view class="toggle sm {{missed ? 'on' : ''}}" hover-class="press" hover-stay-time="80" bindtap="onMissed"><view class="knob"></view></view>
    </view>
  </view>

  <!-- 購物車 -->
  <view class="wrap">
    <view class="section-label list-head">
      <text>購物車 {{cart.length}} 件</text>
      <view class="picked"><text>已選 {{pickedCount}}</text><text wx:if="{{pickedCount}}" class="clear" bindtap="clearAll">全部取消</text></view>
    </view>
    <view wx:if="{{cart.length === 0}}" class="card empty">還沒有購物車清單。直播開始後，電腦會自動讀取。</view>
    <view class="list" wx:if="{{cart.length}}">
      <view wx:for="{{cart}}" wx:key="id" class="item {{picked[item.id] ? 'on' : ''}} {{room.explaining && room.explaining.id === item.id ? 'exp' : ''}}" hover-class="press-row" hover-start-time="40" hover-stay-time="80" data-id="{{item.id}}" bindtap="toggle">
        <view class="idx num-font">{{item.index}}</view>
        <view class="grow">
          <view class="t">{{item.title}}</view>
          <view class="muted">¥{{item.price}}<text wx:if="{{room.explaining && room.explaining.id === item.id}}" class="exp-tag"> · 講解中</text></view>
        </view>
        <view class="check"><view class="tick"></view></view>
      </view>
    </view>
  </view>

  <view class="foot">
    <text class="danger-link" bindtap="remove">刪除這個直播間</text>
  </view>
  <view class="spacer"></view>

  <view class="bottom">
    <view wx:if="{{dirty}}" class="btn" hover-class="press" hover-stay-time="80" bindtap="save">儲存目標 · {{pickedCount}} 件</view>
    <view wx:else class="btn ghost">{{pickedCount ? '已儲存 · ' + pickedCount + ' 件' : '點商品或輸入號碼來選'}}</view>
  </view>
</view>
