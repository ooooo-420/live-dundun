<view class="wrap enter">
  <view class="title">帮电脑过一下验证</view>

  <view class="peek shot-peek">
    <image class="panda-head {{done ? 'hot' : 'idle'}}" src="{{done ? '/images/panda_hot.png' : '/images/panda_head.png'}}" />
    <view class="peek-card shot-card {{busy ? 'busy' : ''}}">
      <block wx:if="{{shot}}">
        <image id="shot" class="shot" src="data:image/jpeg;base64,{{shot.img}}" mode="widthFix" />
        <view class="touch" catchtouchstart="ts" catchtouchmove="tm" catchtouchend="te" catchtouchcancel="te"></view>
        <view wx:if="{{finger}}" class="finger" style="left: {{finger.x}}px; top: {{finger.y}}px"></view>
      </block>
      <view wx:else class="wait">{{done ? '过了！' : '等电脑截屏…'}}</view>
    </view>
    <image wx:if="{{!done}}" class="panda-paws" src="/images/panda_paws.png" />
  </view>

  <view class="steps">
    <view class="step {{stage === 0 ? 'on' : ''}}">① 照画面操作</view>
    <view class="step {{stage === 1 ? 'on' : ''}}">② 电脑照做</view>
    <view class="step {{stage === 2 ? 'on' : ''}}">③ 看结果</view>
  </view>
  <view class="msg {{done ? 'ok' : ''}}">{{msg}}</view>
  <view class="muted note">程序不会自己解验证。一直过不了的话，也可以直接到电脑上的 Edge 完成。</view>
  <view class="spacer"></view>
</view>
<view class="bottom" wx:if="{{!done}}">
  <view class="btn ghost" hover-class="press" hover-stay-time="80" bindtap="refresh">画面不对？重新截屏</view>
</view>
