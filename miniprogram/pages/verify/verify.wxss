.wrap.enter { padding-top: 24rpx; }
.title { font-size: 48rpx; font-weight: 900; }
.shot-peek { margin-top: 190rpx; }
/* 熊猫扒在截屏卡的右上缘，不要挡到图 */
.shot-peek .panda-head, .shot-peek .panda-paws { left: 80%; }
.shot-card { background: #fff; border-radius: 44rpx; overflow: hidden; box-shadow: var(--shadow); min-height: 300rpx; transition: opacity 0.2s; }
.shot-card.busy { opacity: 0.55; }
.shot { display: block; width: 100%; }
.touch { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.finger { position: absolute; width: 64rpx; height: 64rpx; margin: -32rpx 0 0 -32rpx; border-radius: 50%; background: rgba(63, 143, 91, 0.28); border: 5rpx solid var(--bam); pointer-events: none; }
.wait { padding: 120rpx 0; text-align: center; color: var(--soft); font-size: 30rpx; font-weight: 700; }
.steps { display: flex; gap: 14rpx; margin-top: 30rpx; }
.step { flex: 1; text-align: center; padding: 20rpx 6rpx; border-radius: 28rpx; background: var(--card); color: var(--soft); font-size: 24rpx; transition: background 0.2s, color 0.2s; }
.step.on { background: var(--bam-tint); color: var(--bam); font-weight: 700; }
.msg { margin: 28rpx 0 8rpx; min-height: 40rpx; color: var(--soft); text-align: center; }
.msg.ok { color: var(--bam); font-size: 36rpx; font-weight: 900; }
.note { text-align: center; }
.spacer { height: 200rpx; }
.bottom { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 24rpx 44rpx calc(28rpx + env(safe-area-inset-bottom)); background: linear-gradient(rgba(243, 239, 227, 0), var(--bg) 40%); }
