.page-body { padding-bottom: 40rpx; overflow-x: hidden; }
.link { color: var(--tom); margin-left: 12rpx; font-weight: 700; }
.tip { margin-top: 10rpx; }

/* 标题 */
/* 自订导航栏：和微信胶囊同一行；padding-top/height/开关位置由 JS 依胶囊位置算 */
.topbar { position: relative; padding-left: 44rpx; box-sizing: content-box; }
.brand { font-size: 44rpx; font-weight: 900; letter-spacing: -0.01em; }

/* 熊猫：头、爪子各包一层（外层管“缩回去／爬出来”，里面的图管呼吸、抬手、跳） */
.pimg { display: block; width: 100%; height: 100%; }
.pimg.idle { animation: breathe 4.8s ease-in-out infinite; transform-origin: 50% 100%; }
.pimg.go-head { animation: hop 1.05s cubic-bezier(0.3, 0.7, 0.3, 1) both; }
.pimg.go-paws { animation: paws 1.05s cubic-bezier(0.3, 0.7, 0.3, 1) both; }
.pimg.hot { animation: jump 0.7s cubic-bezier(0.3, 1.5, 0.5, 1) both; }
.panda-tap { position: absolute; z-index: 5; left: 72%; width: 284rpx; margin-left: -142rpx; top: -198rpx; height: 198rpx; }
/* 爬出来：先伸手（没有延迟），头再冒上来（晚一点、带回弹） */
.hero .panda-head { transition: transform 0.62s cubic-bezier(0.3, 1.35, 0.5, 1) 0.26s; }
.hero .panda-paws { transition: transform 0.36s cubic-bezier(0.3, 1.4, 0.5, 1), opacity 0.18s; }
/* 缩回去：头先沉下去只剩耳朵和头顶，手再收回 */
.hero.asleep .panda-head { transform: translateY(112rpx); transition: transform 0.4s cubic-bezier(0.5, 0, 0.75, 0); }
.hero.asleep .panda-paws { transform: translateY(72rpx); opacity: 0; transition: transform 0.3s ease-in 0.28s, opacity 0.2s 0.34s; }

/* 电脑没回报：头歪着趴在卡片上睡，手还扒着；呼吸放慢放大，z 一个接一个飘上去 */
.hero.dozing .panda-head { transform: translateY(30rpx) rotate(5deg); transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
.pimg.doze { animation: doze 5.6s ease-in-out infinite; transform-origin: 50% 100%; }
@keyframes doze { 0%, 100% { transform: none; } 50% { transform: translateY(-6rpx) scaleY(1.03); } }
.zzz { position: absolute; z-index: 3; left: 72%; margin-left: 96rpx; top: -250rpx; width: 120rpx; height: 130rpx; pointer-events: none; }
.z { position: absolute; left: 0; bottom: 0; font-weight: 900; color: var(--mute); opacity: 0; animation: zfloat 3.6s ease-out infinite; }
.z1 { font-size: 26rpx; }
.z2 { font-size: 34rpx; animation-delay: 1.2s; }
.z3 { font-size: 44rpx; animation-delay: 2.4s; }
@keyframes zfloat { 0% { transform: translate(0, 0) rotate(-8deg); opacity: 0; } 20% { opacity: 0.9; } 100% { transform: translate(56rpx, -96rpx) rotate(10deg); opacity: 0; } }

/* 号码票 */
.hero { margin-top: 200rpx; }
.ticket { color: #fff; border-radius: 60rpx; background: var(--bam); box-shadow: 0 40rpx 80rpx rgba(52, 121, 76, 0.3); transition: background 0.35s, box-shadow 0.35s; }
.ticket.hot { background: var(--tom); box-shadow: 0 40rpx 88rpx rgba(255, 106, 61, 0.38); }
/* 存根：新号码在 stub-clip 里从撕口冒上来（被裁掉）；撕走的 fly 在 clip 外面，才飞得出票 */
.stub { position: relative; height: 300rpx; }
.stub-clip { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; border-radius: 60rpx 60rpx 0 0; }
.stub-in, .fly { position: absolute; left: 0; right: 0; top: 0; height: 300rpx; padding: 52rpx 44rpx 0; box-sizing: border-box; }
.stub-in.rise { animation: rise 0.5s 0.26s cubic-bezier(0.22, 1, 0.36, 1) both; }
@keyframes rise { from { transform: translateY(240rpx); } to { transform: none; } }
.fly { background: var(--bam); border-radius: 60rpx 60rpx 12rpx 12rpx; z-index: 3; transform-origin: 12% 100%; animation: tear 0.72s cubic-bezier(0.55, 0, 0.8, 0.2) forwards; box-shadow: 0 36rpx 60rpx rgba(0, 0, 0, 0.18); }
.fly.hot { background: var(--tom); }
@keyframes tear { 0% { transform: none; } 22% { transform: rotate(-4deg) translate(8rpx, -16rpx); } 70% { opacity: 1; } 100% { transform: rotate(-28deg) translate(400rpx, -640rpx); opacity: 0; } }

.r1 { display: flex; align-items: center; gap: 16rpx; font-size: 30rpx; font-weight: 700; }
.live-pill { flex: none; font-size: 22rpx; font-weight: 700; background: rgba(255, 255, 255, 0.22); padding: 6rpx 20rpx; border-radius: 30rpx; }
.t-name { margin-left: auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.now { display: flex; align-items: flex-end; gap: 20rpx; margin-top: 16rpx; }
.t-num { font-size: 206rpx; font-weight: 800; line-height: 0.9; }
.t-side { display: flex; flex-direction: column; min-width: 0; font-size: 27rpx; line-height: 1.45; padding-bottom: 20rpx; opacity: 0.95; }
.t-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.idle-now { height: 166rpx; align-items: center; }
.t-wait { font-size: 34rpx; font-weight: 700; opacity: 0.95; }

/* 撕线：虚线＋两边半圆缺口 */
.perf { position: relative; margin: 0 44rpx; border-top: 4rpx dashed rgba(255, 255, 255, 0.4); }
.hole { position: absolute; top: -24rpx; width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--bg); }
.hole.l { left: -66rpx; }
.hole.r { right: -66rpx; }

.tbody { padding: 36rpx 44rpx 34rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.ticket.hot .chip.next { color: var(--tom); }
/* 到号的存根不飞走：往下落到票根那一叠 */
.fly.keep { animation: keep 0.8s cubic-bezier(0.5, 0, 0.7, 0.4) forwards; transform-origin: 20% 50%; }
@keyframes keep { 0% { transform: none; } 20% { transform: rotate(-4deg) translate(8rpx, -16rpx); } 100% { transform: rotate(-3deg) translate(-60rpx, 620rpx) scale(0.34); opacity: 0.2; } }

/* 第三段：三格 */
.fields { display: flex; }
.f { flex: 1; min-width: 0; }
.f + .f { padding-left: 28rpx; margin-left: 4rpx; border-left: 3rpx solid rgba(255, 255, 255, 0.24); }
.f-k { display: block; font-size: 23rpx; font-weight: 600; opacity: 0.85; letter-spacing: 0.04em; }
.f-v { display: flex; align-items: baseline; gap: 8rpx; font-size: 36rpx; font-weight: 800; white-space: nowrap; line-height: 1.3; }
.f-n { font-size: 48rpx; }

/* 票根 */
.stubs { position: relative; height: 150rpx; margin-top: 36rpx; }
.sb { position: absolute; width: 300rpx; height: 128rpx; box-sizing: border-box; padding: 0 28rpx; border-radius: 32rpx 32rpx 12rpx 12rpx; color: #fff; display: flex; align-items: center; gap: 16rpx; background: var(--tom); box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.14); border-bottom: 4rpx dashed rgba(255, 255, 255, 0.55); }
.sb.near { background: #5a9a70; }
.sb.miss { background: #8a9088; }
.sb-n { font-size: 68rpx; font-weight: 800; line-height: 1; }
.sb-t { display: flex; flex-direction: column; font-size: 23rpx; font-weight: 600; line-height: 1.35; }
.sb.land { animation: land 0.5s 0.55s cubic-bezier(0.3, 1.4, 0.5, 1) both; }
@keyframes land { from { opacity: 0; margin-top: -90rpx; } to { opacity: 1; margin-top: 0; } }
.stubs-l { position: absolute; right: 8rpx; top: 46rpx; font-size: 26rpx; font-weight: 700; color: var(--soft); }

.t-prog { height: 12rpx; border-radius: 6rpx; background: rgba(255, 255, 255, 0.22); margin-top: 22rpx; overflow: hidden; }
.t-prog-bar { height: 100%; border-radius: 6rpx; background: #fff; transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
.eta { font-size: 26rpx; font-weight: 600; }
.chips + .eta, .verify-pill + .eta { margin-top: 20rpx; }
.tbody + .perf + .tbody { padding-top: 30rpx; }
.verify-pill { margin-bottom: 24rpx; background: #fff; color: var(--tom); font-weight: 700; font-size: 26rpx; padding: 18rpx 26rpx; border-radius: 30rpx; }

/* 空票 */
/* 空白卡：只有一句话时也要撑得住熊猫，字放在卡片左下，像票面上印的一行字 */
.empty-ticket { min-height: 220rpx; padding: 0 44rpx 44rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: flex-end; }
.e-title { font-size: 44rpx; font-weight: 900; line-height: 1.3; letter-spacing: -0.01em; }
.e-sub { font-size: 26rpx; margin-top: 12rpx; line-height: 1.6; }

/* 其他直播间：小卡片，往左滑删除 */
.rooms { display: flex; flex-direction: column; gap: 20rpx; }
/* 删除键是一颗独立的圆角块，和卡片隔一道缝，跟着手指慢慢浮现；卡片本身不被裁切 */
.room-row { position: relative; }
.del {
  position: absolute; right: 0; top: 0; bottom: 0; visibility: hidden; border-radius: 44rpx;
  background: var(--danger); color: #fff; font-size: 28rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(217, 83, 74, 0.28); transform-origin: 100% 50%;
}
.del.show { visibility: visible; }
.del.snap { transition: opacity 0.3s, transform 0.3s cubic-bezier(0.3, 1.4, 0.5, 1); }
.room { position: relative; background: var(--card); border-radius: 44rpx; padding: 26rpx 30rpx; display: flex; align-items: center; gap: 26rpx; box-shadow: var(--shadow); }
.room.snap { transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
.n { width: 96rpx; height: 96rpx; flex: none; border-radius: 30rpx; background: var(--bg); display: flex; align-items: center; justify-content: center; font-size: 38rpx; font-weight: 800; color: var(--mute); }
.n.live { background: var(--bam-tint); color: var(--bam); }
.r-mid { flex: 1; min-width: 0; }
.r-name { font-size: 30rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.r-sub { font-size: 23rpx; color: var(--mute); }
.r-sub.alert { color: var(--tom); }

.foot { text-align: center; margin-top: 40rpx; }
.foot-link { color: var(--soft); font-size: 26rpx; padding: 20rpx 30rpx; }

/* 底部固定的粘贴键 */
.spacer { height: 200rpx; }
.bottom { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; padding: 24rpx 44rpx calc(28rpx + env(safe-area-inset-bottom)); background: linear-gradient(rgba(243, 239, 227, 0), var(--bg) 40%); }
.paste { display: flex; align-items: center; justify-content: center; gap: 18rpx; height: 116rpx; line-height: 116rpx; border-radius: 58rpx; }
.plus { width: 50rpx; height: 50rpx; line-height: 48rpx; border-radius: 50%; background: var(--bam); color: #fff; text-align: center; font-size: 36rpx; }

/* 邀请码 */
.join { padding-top: 260rpx; }
.join-card { padding: 60rpx 44rpx 44rpx; }
.join-title { font-size: 48rpx; font-weight: 900; }
.join-sub { font-size: 26rpx; margin: 10rpx 0 40rpx; }
.code-input { height: 120rpx; font-size: 56rpx; letter-spacing: 0.3em; text-align: center; margin-bottom: 28rpx; }
