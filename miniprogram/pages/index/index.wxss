.link { color: var(--ember); margin-left: 12rpx; }
.row-between { display: flex; justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.tip { margin-top: 14rpx; }

/* 狀態列 */
.status { display: flex; align-items: center; gap: 24rpx; padding-top: 32rpx; padding-bottom: 8rpx; }
.status-text { flex: 1; min-width: 0; font-size: 30rpx; }

/* 直播間列表：細線分隔，不用卡片 */
.rooms { border-top: 1rpx solid var(--line); }
.room-row { position: relative; overflow: hidden; border-bottom: 1rpx solid var(--line); }
.del {
  position: absolute; right: 0; top: 0; bottom: 0;
  background: var(--danger); color: #fff; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
  visibility: hidden;  /* 沒滑開時藏起來，避免邊緣露出一條 */
}
.del.show { visibility: visible; }.room { position: relative; background: var(--void); padding: 28rpx 32rpx 30rpx; }
.room.snap { transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1); }

.room-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.room-name { font-size: 30rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.room-state { flex: none; font-size: 22rpx; color: var(--mute); display: flex; align-items: center; gap: 10rpx; }
.room-state.live { color: var(--ember); }
.room-state.alert { color: #ff8a73; }
.dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--ember); }

.now { display: flex; align-items: flex-end; gap: 20rpx; margin: 18rpx 0 6rpx; }
.big { font-size: 128rpx; line-height: 0.9; font-weight: 700; color: var(--ember); }
.now-side { display: flex; flex-direction: column; min-width: 0; padding-bottom: 8rpx; }
.now-title { font-size: 24rpx; color: var(--soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* B 型：講到幾號 / 目標幾號 的進度線 */
.prog { height: 3rpx; background: var(--line); margin: 14rpx 0 4rpx; }
.prog-bar { height: 100%; background: var(--ember); transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1); }

.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }

.empty { padding-top: 40rpx; padding-bottom: 24rpx; }
/* 空狀態：一個靜止的小吸積盤（和頭像呼應） */
.empty-disk { width: 96rpx; height: 96rpx; position: relative; margin-bottom: 28rpx; }
.empty-disk .ring { position: absolute; inset: 0; border-radius: 50%; box-sizing: border-box;
  border: 8rpx solid rgba(255, 181, 107, 0.12); border-top-color: rgba(255, 181, 107, 0.7); border-right-color: rgba(255, 181, 107, 0.35); transform: rotate(-30deg); }
.empty-disk .core { position: absolute; left: 30rpx; top: 30rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #020205; box-shadow: 0 0 0 2rpx rgba(255, 181, 107, 0.2); }

/* 加入 */
.add-row { display: flex; gap: 16rpx; }
.add-btn { width: 140rpx; flex: none; }

.foot { padding-top: 64rpx; padding-bottom: 80rpx; text-align: center; }
.foot-link { color: var(--soft); font-size: 26rpx; padding: 20rpx 32rpx; }

/* 邀請碼 */
.join { padding-top: 80rpx; }
.hero-title { font-size: 56rpx; font-weight: 700; letter-spacing: -0.02em; }
.hero-sub { margin: 12rpx 0 48rpx; font-size: 26rpx; }
.code-input { height: 120rpx; font-size: 56rpx; letter-spacing: 0.3em; text-align: center; margin-bottom: 24rpx; }
