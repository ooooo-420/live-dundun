<wxs src="../../utils/text.wxs" module="tx" />
<!-- 自订导航栏：名字放在微信胶囊按钮那一行，顶部不留空 -->
<view class="topbar" style="padding-top: {{nav.top}}px; height: {{nav.h}}px">
  <view class="brand" style="line-height: {{nav.h}}px">{{brand}}</view>
</view>
<view wx:if="{{demo}}" class="banner warn">示范数据，还没连到电脑。<text class="link" bindtap="resetDemo">重设</text></view>
<view wx:if="{{error}}" class="banner err">连不上云端：{{error}}</view>

<!-- 还没加入：输入邀请码 -->
<view class="wrap join" wx:if="{{needJoin}}">
  <view class="peek join-peek">
    <image class="panda-head idle" src="/images/panda_head.png" />
    <view class="peek-card card join-card">
      <view class="join-title">输入邀请码</view>
      <view class="soft join-sub">请已经在用的帐号打开“成员与邀请”，生成一组 6 位数字，30 分钟内有效。</view>
      <input class="input code-input num-font" type="number" maxlength="6" placeholder="000000" placeholder-class="ph" value="{{code}}" bindinput="onCode" />
      <view class="btn" hover-class="press" hover-stay-time="80" bindtap="joinNow">加入</view>
    </view>
    <image class="panda-paws" src="/images/panda_paws.png" />
  </view>
</view>

<view wx:else class="page-body">
  <!-- 熊猫就是监控开关：关着时缩在卡片后面只露头顶，点一下先伸出双手、再爬出来 -->
  <view class="wrap">
    <view class="peek hero enter {{sleep ? 'dozing' : (monitoring ? '' : 'asleep')}}">
      <!-- 电脑没回报：熊猫趴着睡，头上飘 z -->
      <view wx:if="{{sleep}}" class="zzz"><text class="z z1">z</text><text class="z z2">z</text><text class="z z3">Z</text></view>
      <view class="panda-head"><image class="pimg {{sleep ? 'doze' : (hero && hero.hot ? 'hot' : (hero && hero.bump ? 'go-head' : (monitoring ? 'idle' : '')))}}" src="{{sleep ? '/images/panda_sleep.png' : (hero && hero.hot ? '/images/panda_hot.png' : '/images/panda_head.png')}}" /></view>
      <view wx:if="{{!demo}}" class="panda-tap" bindtap="tapPanda"></view>

      <!-- 号码票：正在盯的那一间 -->
      <view wx:if="{{hero}}" class="peek-card ticket {{hero.hot ? 'hot' : ''}}" hover-class="press-row" hover-stay-time="100" bindtap="openHero" bindlongpress="heroMenu">
        <view class="stub">
          <view class="stub-clip"><view class="stub-in {{hero.bump ? 'rise' : ''}}">
            <view class="r1"><text class="live-pill">{{hero.pill}}</text><text class="t-name">{{hero.name}}</text></view>
            <view class="now" wx:if="{{hero.explaining && hero.explaining.index}}">
              <text class="t-num num-font">{{hero.explaining.index}}</text>
              <view class="t-side"><text>号 {{hero.hot ? '到了！' : '讲解中'}}</text><text class="t-title {{tx.hang(hero.explaining.title) ? 'hang' : ''}}">{{hero.explaining.title}}</text></view>
            </view>
            <view class="now idle-now" wx:else><text class="t-wait">{{hero.waitText}}</text></view>
          </view></view>
          <!-- 被撕走的旧存根 -->
          <view wx:if="{{fly}}" class="fly {{fly.hot ? 'hot keep' : ''}}">
            <view class="r1"><text class="live-pill">{{fly.pill}}</text><text class="t-name">{{fly.name}}</text></view>
            <view class="now"><text class="t-num num-font">{{fly.index}}</text><view class="t-side"><text>号 讲解中</text><text class="t-title {{tx.hang(fly.title) ? 'hang' : ''}}">{{fly.title}}</text></view></view>
          </view>
        </view>
        <view class="perf"><view class="hole l"></view><view class="hole r"></view></view>
        <view class="tbody">
          <view wx:if="{{hero.status === 'captcha'}}" class="verify-pill" hover-class="press" catchtap="goVerifyHero">抖音要人机验证 · 点这里在手机上完成 ›</view>
          <view class="chips" wx:if="{{hero.chips.length}}">
            <text wx:for="{{hero.chips}}" wx:for-item="c" wx:key="key" class="chip num-font {{c.cls}}">{{c.text}}</text>
          </view>
          <view wx:if="{{hero.eta}}" class="eta">{{hero.eta}}</view>
        </view>
        <!-- 第三段：三格（下一个／还差／大约），像登机牌下半截 -->
        <view wx:if="{{hero.fields.length}}" class="perf"><view class="hole l"></view><view class="hole r"></view></view>
        <view wx:if="{{hero.fields.length}}" class="tbody">
          <view class="fields">
            <view wx:for="{{hero.fields}}" wx:for-item="f" wx:key="k" class="f">
              <text class="f-k">{{f.k}}</text>
              <view class="f-v"><text wx:if="{{f.v}}" class="f-n num-font">{{f.v}}</text><text>{{f.u}}</text></view>
            </view>
          </view>
          <view wx:if="{{hero.prog}}" class="t-prog"><view class="t-prog-bar" style="width: {{hero.prog}}%"></view></view>
        </view>
      </view>

      <!-- 没有在盯的：一张空白的票 -->
      <view wx:else class="peek-card card empty-ticket">
        <view wx:if="{{sleep}}" class="e-title">电脑睡着了</view>
        <view wx:if="{{sleep}}" class="soft e-sub">上次回报：{{pcText}}</view>
        <view wx:elif="{{!monitoring}}" class="e-title"><view>点一下熊猫，</view><view>开始帮你盯</view></view>
        <view wx:else class="e-title">{{rooms.length ? '选一间来盯' : '还没有直播间'}}</view>
        <view class="soft e-sub" wx:if="{{!sleep && monitoring && !rooms.length}}">在抖音直播间点“分享 → 复制链接”，再按下面的按钮</view>
      </view>

      <view wx:if="{{!(hero && hero.hot)}}" class="panda-paws"><image class="pimg {{hero && hero.bump ? 'go-paws' : ''}}" src="/images/panda_paws.png" /></view>
    </view>

    <!-- 票根：叫过你的号，撕下来叠在票下面；点开是通知记录 -->
    <view wx:if="{{stubs.length}}" class="stubs" hover-class="press-row" hover-stay-time="100" bindtap="openStubs">
      <view wx:for="{{stubs}}" wx:key="id" class="sb {{item.cls}} {{item.fresh ? 'land' : ''}}" style="left: {{index * 124}}rpx; top: {{index * 8}}rpx; transform: rotate({{index % 2 ? 3 : -3}}deg)">
        <text class="sb-n num-font">{{item.n}}</text>
        <view class="sb-t"><text>{{item.label}}</text><text>{{item.time}}</text></view>
      </view>
      <text class="stubs-l">票根 {{stubCount}} ›</text>
    </view>
  </view>

  <!-- 其他直播间 -->
  <view class="wrap" wx:if="{{others.length}}">
    <view class="section-label">{{hero ? '其他直播间' : '直播间'}}</view>
  </view>
  <view class="wrap rooms">
    <view wx:for="{{others}}" wx:key="id" class="room-row enter" style="animation-delay: {{index < 6 ? index * 50 : 300}}ms">
      <view class="del {{item.x || item.drag ? 'show' : ''}} {{item.drag ? '' : 'snap'}}" style="width: {{delPx - gapPx}}px; opacity: {{-item.x / delPx}}; transform: scale({{0.7 + 0.3 * (-item.x / delPx)}})" hover-class="press-link" data-id="{{item.id}}" catchtap="askRemove">删除</view>
      <view class="room {{item.drag ? '' : 'snap'}}" style="transform: translateX({{item.x}}px)"
        hover-class="{{item.drag || item.x ? 'none' : 'press-row'}}" hover-start-time="60" hover-stay-time="100"
        data-i="{{index}}" bindtap="open" bindtouchstart="touchStart" bindtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd">
        <view class="n num-font {{item.live ? 'live' : ''}}">{{item.live && item.explaining && item.explaining.index ? item.explaining.index : '—'}}</view>
        <view class="r-mid">
          <view class="r-name">{{item.name}}</view>
          <view class="r-sub {{item.alert ? 'alert' : ''}}">{{item.subText}}</view>
        </view>
        <view wx:if="{{monitoring && !sleep}}" class="toggle sm {{item.watch ? 'on' : ''}} {{item.watchBusy ? 'busy' : ''}}" hover-class="press" hover-stay-time="80" data-id="{{item.id}}" catchtap="toggleWatch"><view class="knob"></view></view>
      </view>
    </view>
  </view>

  <view wx:if="{{pending}}" class="wrap muted tip">有 {{pending}} 个指令等电脑处理</view>
  <view class="foot"><text class="foot-link" bindtap="openMembers">成员与邀请</text></view>
  <view class="spacer"></view>

  <view class="bottom">
    <view class="btn dark paste {{busy ? 'off' : ''}}" hover-class="press" hover-stay-time="80" bindtap="pasteAdd"><text class="plus">＋</text>粘贴抖音直播链接</view>
  </view>
</view>
