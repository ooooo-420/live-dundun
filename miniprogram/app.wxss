/* 直播蹲蹲：叫号单。奶油纸底、竹青主色、到号变番茄橘；圆角、带颜色的淡阴影；吉祥物是扒在票上的熊猫。 */
page {
  --bg: #f3efe3;
  --card: #fffdf8;
  --ink: #1f2a22;
  --soft: #5e675f;
  --mute: #9aa39a;
  --line: #e6e0d1;
  --bam: #3f8f5b;
  --bam-tint: #e3f0e6;
  --tom: #ff6a3d;
  --tom-tint: #ffece4;
  --danger: #d9534a;
  --shadow: 0 16rpx 48rpx rgba(70, 90, 60, 0.09);
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang TC", "PingFang SC", "Noto Sans TC", sans-serif;
}

.wrap { padding: 0 44rpx; box-sizing: border-box; }
.muted { color: var(--mute); font-size: 24rpx; }
.soft { color: var(--soft); }
.num-font, .display-font { font-family: "LiveNum", "SF Pro Rounded", "Avenir Next", "DIN Alternate", -apple-system, sans-serif; font-variant-numeric: tabular-nums; letter-spacing: -0.03em; }

.section-label { color: var(--soft); font-size: 28rpx; font-weight: 700; margin: 48rpx 8rpx 20rpx; }
.row-between { display: flex; justify-content: space-between; align-items: center; }
/* 标点悬挂（配合 utils/text.wxs）：开头的全角引号往左挪半格 */
.hang { text-indent: -0.5em; }

/* 按钮：胶囊形 */
.btn {
  background: var(--bam); color: #fff; font-size: 30rpx; font-weight: 700;
  height: 100rpx; line-height: 100rpx; border-radius: 50rpx; text-align: center;
  box-shadow: 0 20rpx 44rpx rgba(63, 143, 91, 0.3);
  transition: transform 0.14s ease-out, opacity 0.14s ease-out, background 0.2s;
}
.btn.dark { background: var(--ink); color: var(--bg); box-shadow: 0 20rpx 44rpx rgba(31, 42, 34, 0.26); }
.btn.ghost { background: var(--card); color: var(--soft); box-shadow: inset 0 0 0 3rpx var(--line); }
.btn.off { opacity: 0.45; box-shadow: none; }

/* 按下去的回馈（微信原生 hover-class） */
.press { transform: scale(0.96); opacity: 0.88; }
.press-row { transform: scale(0.985); }
.press-link { opacity: 0.5; }
.link-btn { display: inline-block; padding: 16rpx 24rpx; }

/* 第一次出现：由下往上淡入 */
.enter { animation: enter 0.45s cubic-bezier(0.22, 1, 0.36, 1) both; }
@keyframes enter { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: none; } }

.input {
  background: var(--card); color: var(--ink); height: 100rpx; border-radius: 50rpx;
  padding: 0 36rpx; font-size: 30rpx; box-shadow: inset 0 0 0 3rpx var(--line);
}
.input.focus { box-shadow: inset 0 0 0 3rpx var(--bam); }
.ph { color: #b3ad9f; }

.banner { margin: 20rpx 44rpx 0; padding: 18rpx 28rpx; font-size: 24rpx; border-radius: 28rpx; background: var(--card); color: var(--soft); }
.banner.warn { background: var(--tom-tint); color: #b4471f; }
.banner.err { background: #fde8e6; color: var(--danger); }

/* 卡片 */
.card { background: var(--card); border-radius: 44rpx; box-shadow: var(--shadow); }

/* 开关 */
.toggle {
  width: 104rpx; height: 62rpx; flex: none; position: relative; box-sizing: border-box;
  border-radius: 31rpx; background: #d9d3c4; transition: background 0.22s ease;
}
.toggle .knob {
  position: absolute; left: 7rpx; top: 7rpx; width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #fff; box-shadow: 0 4rpx 10rpx rgba(20, 40, 20, 0.22);
  transition: transform 0.26s cubic-bezier(0.3, 1.4, 0.5, 1);
}
.toggle.on { background: var(--bam); }
.toggle.on .knob { transform: translateX(42rpx); }
.toggle.busy { opacity: 0.55; }
.toggle.sm { width: 84rpx; height: 50rpx; border-radius: 25rpx; }
.toggle.sm .knob { width: 38rpx; height: 38rpx; left: 6rpx; top: 6rpx; }
.toggle.sm.on .knob { transform: translateX(34rpx); }

/* 号码标签（胶囊） */
.chip {
  min-width: 80rpx; height: 64rpx; padding: 0 24rpx; box-sizing: border-box; border-radius: 32rpx;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 800; background: rgba(255, 255, 255, 0.2); color: #fff;
}
.chip.next { background: #fff; color: var(--bam); }
.chip.done { opacity: 0.45; text-decoration: line-through; }
.chip.pop { animation: pop 0.5s 0.8s cubic-bezier(0.3, 1.6, 0.5, 1) both; }
@keyframes pop { from { transform: scale(0.6); } to { transform: none; } }

/* 熊猫：头和爪子分两张图，爪子扒在卡片上缘、盖在卡片前面 */
.peek { position: relative; }
/* 284×241rpx（设计稿 148px）；卡片上缘对在熊猫图的 y=140/170 → 往上 198rpx */
.panda-head, .panda-paws { position: absolute; width: 284rpx; height: 241rpx; left: 72%; margin-left: -142rpx; top: -198rpx; pointer-events: none; }
.panda-head { z-index: 1; }
.panda-paws { z-index: 4; }
.peek-card { position: relative; z-index: 2; }
/* 平常：慢慢眨眼不好做成图片，改成头轻轻呼吸 */
.panda-head.idle { animation: breathe 4.8s ease-in-out infinite; transform-origin: 50% 100%; }
@keyframes breathe { 0%, 100% { transform: none; } 50% { transform: translateY(-4rpx) scaleY(1.015); } }
/* 换号：两手举起让位、头弹一下，然后爬回来扒好 */
.panda-paws.go { animation: paws 1.05s cubic-bezier(0.3, 0.7, 0.3, 1) both; }
@keyframes paws { 0% { transform: none; } 16% { transform: translateY(-50rpx) scaleY(1.05); } 62% { transform: translateY(-50rpx); } 80% { transform: translateY(8rpx) scaleY(0.94); } 90% { transform: translateY(-3rpx); } 100% { transform: none; } }
.panda-head.go { animation: hop 1.05s cubic-bezier(0.3, 0.7, 0.3, 1) both; }
@keyframes hop { 0% { transform: none; } 16% { transform: translateY(-20rpx); } 62% { transform: translateY(-20rpx); } 80% { transform: translateY(4rpx); } 100% { transform: none; } }
/* 到号：跳起来 */
.panda-head.hot { animation: jump 0.7s cubic-bezier(0.3, 1.5, 0.5, 1) both; }
@keyframes jump { from { transform: translateY(40rpx); } to { transform: translateY(-24rpx); } }
